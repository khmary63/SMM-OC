{
  "name": "WF-PUB-007 — Publish to YouTube",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [{ "name": "publication_id", "type": "string" }]
        }
      },
      "id": "trigger",
      "name": "Sub-workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "select p.id, p.workspace_id, p.external_post_id,\n       cv.body, coalesce(cv.title, ci.title) as video_title, cv.hashtags,\n       a.storage_bucket, a.storage_path, a.mime_type\n  from public.publications p\n  join public.content_variants cv on cv.id = p.content_variant_id\n  join public.content_items ci on ci.id = cv.content_item_id\n  left join public.content_assets ca on ca.content_variant_id = cv.id\n  left join public.assets a on a.id = ca.asset_id and a.type = 'video'\n where p.id = $1::uuid\n   and p.status in ('queued','processing')\n order by ca.sort_order\n limit 1;",
        "options": { "queryReplacement": "={{ [$json.publication_id] }}" }
      },
      "id": "load",
      "name": "Load Publication + Video Asset",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [220, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_SUPABASE_PG_CREDENTIAL",
          "name": "Supabase Postgres (service)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const row = $input.first().json;\nif (!row || !row.id) throw new Error('Publication not found or already processed');\nif (row.external_post_id) return [{ json: { ...row, skip: true } }];\nif (!row.storage_path) throw new Error('К варианту не прикреплено видео (assets.type=video). Прикрепите ролик в медиатеке.');\n\nconst description = [row.body, (row.hashtags ?? []).map(h => `#${h}`).join(' ')]\n  .filter(Boolean).join('\\n\\n');\n\nreturn [{ json: { ...row, description, skip: false } }];"
      },
      "id": "guard",
      "name": "Idempotency Guard",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [440, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL + '/storage/v1/object/sign/' + $json.storage_bucket + '/' + $json.storage_path }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "={{ 'Bearer ' + $env.SUPABASE_SERVICE_ROLE_KEY }}" },
            { "name": "apikey", "value": "={{ $env.SUPABASE_SERVICE_ROLE_KEY }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"expiresIn\": 3600}",
        "options": { "timeout": 15000 }
      },
      "id": "sign",
      "name": "Create Signed URL (Storage)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL + '/storage/v1' + $json.signedURL }}",
        "options": {
          "timeout": 600000,
          "response": { "response": { "responseFormat": "file" } }
        }
      },
      "id": "download",
      "name": "Download Video (binary)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [880, 0]
    },
    {
      "parameters": {
        "resource": "video",
        "operation": "upload",
        "title": "={{ $('Idempotency Guard').item.json.video_title }}",
        "regionCode": "RU",
        "categoryId": "22",
        "options": {
          "description": "={{ $('Idempotency Guard').item.json.description }}",
          "privacyStatus": "public"
        },
        "binaryProperty": "data"
      },
      "id": "upload",
      "name": "YouTube Upload",
      "type": "n8n-nodes-base.youTube",
      "typeVersion": 1,
      "position": [1100, 0],
      "credentials": {
        "youTubeOAuth2Api": {
          "id": "REPLACE_WITH_YOUTUBE_OAUTH_CREDENTIAL",
          "name": "YouTube OAuth2 (Google Cloud)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "update public.publications\n   set status='published', external_post_id=$2, external_url=$3,\n       published_at=now(), last_attempt_at=now(), attempt_count=attempt_count+1,\n       locked_at=null, locked_by=null, updated_at=now()\n where id=$1::uuid\n returning id, workspace_id;",
        "options": {
          "queryReplacement": "={{ [$('Idempotency Guard').item.json.id, $json.id, 'https://youtu.be/' + $json.id] }}"
        }
      },
      "id": "save",
      "name": "Save External ID + published",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1320, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_SUPABASE_PG_CREDENTIAL",
          "name": "Supabase Postgres (service)"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "insert into public.automation_jobs (workspace_id, job_type, entity_type, entity_id, idempotency_key, run_after, payload)\nselect p.workspace_id, 'collect_post_metrics', 'publication', p.id,\n       'snapshot:' || p.id || ':' || bucket.b,\n       p.published_at + bucket.iv,\n       jsonb_build_object('age_bucket', bucket.b, 'platform', 'youtube')\n  from public.publications p,\n       (values ('24h', interval '24 hours'), ('72h', interval '72 hours'), ('7d', interval '7 days'), ('30d', interval '30 days')) as bucket(b, iv)\n where p.id = $1::uuid\non conflict (idempotency_key) do nothing;",
        "options": { "queryReplacement": "={{ [$json.id] }}" }
      },
      "id": "snapshots",
      "name": "Create Snapshot Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1540, 0],
      "credentials": {
        "postgres": {
          "id": "REPLACE_WITH_SUPABASE_PG_CREDENTIAL",
          "name": "Supabase Postgres (service)"
        }
      }
    },
    {
      "parameters": {
        "workflowId": "REPLACE_WITH_WF_CORE_004_ID",
        "workflowInputs": {
          "value": {
            "workspace_id": "={{ $('Save External ID + published').item.json.workspace_id }}",
            "event_type": "publication.published",
            "data": "={{ { publication_id: $('Save External ID + published').item.json.id, platform: 'youtube' } }}"
          }
        },
        "options": { "waitForSubWorkflow": false }
      },
      "id": "emit",
      "name": "Emit Webhook Event",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.2,
      "position": [1760, 0]
    }
  ],
  "connections": {
    "Sub-workflow Trigger": { "main": [[{ "node": "Load Publication + Video Asset", "type": "main", "index": 0 }]] },
    "Load Publication + Video Asset": { "main": [[{ "node": "Idempotency Guard", "type": "main", "index": 0 }]] },
    "Idempotency Guard": { "main": [[{ "node": "Create Signed URL (Storage)", "type": "main", "index": 0 }]] },
    "Create Signed URL (Storage)": { "main": [[{ "node": "Download Video (binary)", "type": "main", "index": 0 }]] },
    "Download Video (binary)": { "main": [[{ "node": "YouTube Upload", "type": "main", "index": 0 }]] },
    "YouTube Upload": { "main": [[{ "node": "Save External ID + published", "type": "main", "index": 0 }]] },
    "Save External ID + published": { "main": [[{ "node": "Create Snapshot Jobs", "type": "main", "index": 0 }]] },
    "Create Snapshot Jobs": { "main": [[{ "node": "Emit Webhook Event", "type": "main", "index": 0 }]] }
  },
  "settings": { "errorWorkflow": "WF-CORE-001" }
}
