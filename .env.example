# ---------------------------------------------------------------------------
# MARIA SMM OS — переменные окружения
# Скопируйте в apps/web/.env.local (для веб-приложения) и заполните значения.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Только сервер! Никогда не передавать в браузер.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Базовый URL приложения
APP_BASE_URL=http://localhost:3000

# AI Gateway (Anthropic Claude API)
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# n8n orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/smm-os/jobs
N8N_WEBHOOK_TOKEN=change-me-shared-hmac-secret

# Telegram MTProto collector (services/telegram-collector)
TELEGRAM_STATS_URL=http://localhost:8081
TELEGRAM_STATS_TOKEN=change-me

# Video render worker (services/video-worker)
VIDEO_RENDER_URL=http://localhost:8082
VIDEO_RENDER_TOKEN=change-me

# MAX Bot API
MAX_API_BASE_URL=https://botapi.max.ru
