# ---------------------------------------------------------------------------
# MARIA SMM OS — переменные окружения
# Скопируйте в apps/web/.env.local (для веб-приложения) и заполните значения.
# ---------------------------------------------------------------------------

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Только сервер! Никогда не передавать в браузер.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Базовый URL приложения
APP_BASE_URL=http://localhost:3000

# AI Gateway
# Провайдер: anthropic (прямой Claude API) или openai (OpenAI-совместимый endpoint).
# ВАЖНО: Claude API недоступен с российских IP — на сервере в РФ используйте
# AI_PROVIDER=openai с OpenRouter или другим совместимым шлюзом.
AI_PROVIDER=anthropic

# Вариант A — Anthropic напрямую (вне РФ):
ANTHROPIC_API_KEY=sk-ant-...
AI_MODEL=claude-sonnet-5

# Вариант B — OpenAI-совместимый шлюз (OpenRouter и т.п.), для РФ:
#   AI_PROVIDER=openai
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=sk-or-...
#   AI_MODEL=anthropic/claude-sonnet-4.5   # или deepseek/deepseek-chat, google/gemini-... и т.д.
AI_BASE_URL=
AI_API_KEY=

# n8n orchestrator
N8N_WEBHOOK_URL=http://localhost:5678/webhook/smm-os/jobs
N8N_WEBHOOK_TOKEN=change-me-shared-hmac-secret

# Telegram MTProto collector (services/telegram-collector)
TELEGRAM_STATS_URL=http://localhost:8081
TELEGRAM_STATS_TOKEN=change-me

# Video render worker (services/video-worker)
VIDEO_RENDER_URL=http://localhost:8082
VIDEO_RENDER_TOKEN=change-me

# MAX Bot API
MAX_API_BASE_URL=https://botapi.max.ru
